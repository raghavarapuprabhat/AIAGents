_letter row, case = FAILED_PUBLISH_V21" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#C0392B;fontColor=#C0392B;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="358" as="sourcePoint"/><mxPoint x="605.0" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="POST /onboarding/orchestration-failed  {orchestrationId, caseId, stage, reason, failedSchemas}" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#C0392B;fontColor=#C0392B;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="412" as="sourcePoint"/><mxPoint x="125.0" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="This callback is the escalation contract: Onboarding learns the case did not land and can re-push it." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="452" width="250" height="71" as="geometry"/></mxCell><mxCell id="n24" value="POST /orchestrations  (same caseId + caseVersion)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="520" as="sourcePoint"/><mxPoint x="365.0" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="idempotency key hit on a FAILED case -&gt; resume, do not duplicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry r