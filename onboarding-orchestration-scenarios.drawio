" as="geometry"/></mxCell><mxCell id="pg8_23" value="B is durably accepted immediately; only its processing is deferred, so Onboarding is never blocked or throttled." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9C89A;fontSize=12;fontColor=#1F2430;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="64" y="602" width="782" height="46" as="geometry"/></mxCell><mxCell id="pg8_24" value="case A completes all legs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="680" as="sourcePoint"/><mxPoint x="463.0" y="714" as="targetPoint"/><Array as="points"><mxPoint x="585.0" y="680"/><mxPoint x="585.0" y="714"/></Array></mxGeometry></mxCell><mxCell id="pg8_25" value="8" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="670" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg8_26" value="same txn: A = COMPLETED and promote B = ACCEPTED" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="744" as="sourcePoint"/><mxPoint x="731.0" y="744" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg8_27" value="9" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="734" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg8_28" value="Promotion happens inside the terminating transaction, so two events for one client are never live at once." 