" as="geometry"><mxPoint x="365.0" y="410" as="sourcePoint"/><mxPoint x="605.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="202  {orchestrationId B}   (accepted, not yet processing)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="464" as="sourcePoint"/><mxPoint x="125.0" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="B is durably accepted immediately. Only its processing is deferred, so Onboarding is never blocked." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="504" width="250" height="71" as="geometry"/></mxCell><mxCell id="n24" value="case A completes all legs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="572" as="sourcePoint"/><mxPoint x="365.0" y="602" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="572"/><mxPoint x="483.0" y="602"/></Array></mxGeometry></mxCell><mxCell id="n25" value="same txn: A -&gt; COMPLETED and promote B -&gt; ACCEPTED" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="624" as="sourcePoint"/><mxPoint x="605.0" y="624" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="Promotion is inside the terminating transaction, so two events for one client are never live at once." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="664" width="250" height="71" as="geometry"/></mxCell><mxCell id="n27" value="case B pipeline begins" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="732" as="sourcePoint"/><mxPoint x="365.0" y="762" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="732"/><mxPoint x="483.0" y="762"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="9. Ops replay"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Scenario 9 — Ops Replay From a Chosen Stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="n12" value="Every stage is idempotent and re-runnable from its persisted input" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Ops / Dashboard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="560" as="geometry"/></mxCell><mxCell id="n14" value="Orchestration Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="170" height="560" as="geometry"/></mxCell><mxCell id="n15" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="170" height="560" as="geometry"/></mxCell><mxCell id="n16" value="Central Data Lake" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="96" width="170" height="560" as="geometry"/></mxCell><mxCell id="n17" value="GET /orchestrations?status=FAILED_*  (dashboard)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="142" as="sourcePoint"/><mxPoint x="365.0" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="dead-letter list with stage, error, journalIds so far" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="196" as="sourcePoint"/><mxPoint x="125.0" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="POST /orchestrations/{id}/replay?fromStage=HYDRATE  + reason" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="250" as="sourcePoint"/><mxPoint x="365.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="reset status, re-enqueue HYDRATE job, audit actor + reason" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="304" as="sourcePoint"/><mxPoint x="605.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="re-read all 9 schemas" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="358" as="sourcePoint"/><mxPoint x="845.0" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="payloads + journalIds" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="412" as="sourcePoint"/><mxPoint x="365.0" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="hydrate, convert, publish — stages after HYDRATE re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="466" as="sourcePoint"/><mxPoint x="365.0" y="496" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="466"/><mxPoint x="483.0" y="496"/></Array></mxGeometry></mxCell><mxCell id="n24" value="status = COMPLETED" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="518" as="sourcePoint"/><mxPoint x="605.0" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="Stages before the replay point are never re-executed. Re-ingestion yields fresh journalIds that supersede the old." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="558" width="250" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page10" name="10. Duplicate re-push"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Scenario 10 — Onboarding Re-pushes a Case That Is Already Healthy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="n12" value="Idempotency: a caller retry after a lost response must never create a second pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Onboarding v2" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="558" as="geometry"/></mxCell><mxCell id="n14" value="Orchestration Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="170" height="558" as="geometry"/></mxCell><mxCell id="n15" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="170" height="558" as="geometry"/></mxCell><mxCell id="n16" value="POST /orchestrations  (response was lost on the network)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="142" as="sourcePoint"/><mxPoint x="365.0" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n17" value="lookup Idempotency-Key = caseId + caseVersion" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="196" as="sourcePoint"/><mxPoint x="605.0" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="key found, case is healthy and in flight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="250" as="sourcePoint"/><mxPoint x="365.0" y="280" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="250"/><mxPoint x="483.0" y="280"/></Array></mxGeometry></mxCell><mxCell id="n19" value="202  {same orchestrationId}   nothing reprocessed" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="302" as="sourcePoint"/><mxPoint x="125.0" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="Same key + same payload = replay of the original response. No duplicate jobs, no duplicate lake ingestion." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="342" width="250" height="86" as="geometry"/></mxCell><mxCell id="n21" value="POST same caseId + caseVersion but a DIFFERENT payload" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="410" as="sourcePoint"/><mxPoint x="365.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="request_hash differs from the accepted one" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#C0392B;fontColor=#C0392B;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="464" as="sourcePoint"/><mxPoint x="365.0" y="494" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="464"/><mxPoint x="483.0" y="494"/></Array></mxGeometry></mxCell><mxCell id="n23" value="409 Conflict — flagged, never silently overwritten" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#C0392B;fontColor=#C0392B;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="516" as="sourcePoint"/><mxPoint x="125.0" y="516" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n24" value="A changed payload under an existing version is a data-integrity signal, not a retry. It is escalated." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="556" width="250" height="71" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page11" name="11. Job row lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Job Row Lifecycle — the exact state and column changes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="26" as="geometry"/></mxCell><mxCell id="t2" value="One row in orchestration_job. Retry, orphan recovery and replay are all just transitions on this row." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1200" height="20" as="geometry"/></mxCell><mxCell id="PEND" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;status=PENDING &#183; due at next_attempt_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="220" height="66" as="geometry"/></mxCell><mxCell id="INPR" value="&lt;b&gt;IN_PROGRESS&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;locked_by, locked_at set (lease)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#028090;" vertex="1" parent="1"><mxGeometry x="430" y="260" width="220" height="66" as="geometry"/></mxCell><mxCell id="DONE" value="&lt;b&gt;DONE&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;finished_at set&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#028090;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="220" height="66" as="geometry"/></mxCell><mxCell id="RETW" value="&lt;b&gt;RETRY_WAIT&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;attempts+1 &#183; next_attempt_at pushed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#B7791F;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="220" height="66" as="geometry"/></mxCell><mxCell id="DEAD" value="&lt;b&gt;DEAD&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;retry budget exhausted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="430" y="590" width="220" height="66" as="geometry"/></mxCell><mxCell id="DLR" value="&lt;b&gt;dead_letter row&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;case = FAILED_&lt;stage&gt; &#183; alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="820" y="590" width="240" height="66" as="geometry"/></mxCell><mxCell id="REAP" value="&lt;b&gt;Reaper (every 1 min)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;finds expired leases&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#B7791F;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="220" height="66" as="geometry"/></mxCell><mxCell id="REPL" value="&lt;b&gt;Ops replay&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;audited, reason required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=none;fontColor=#ffffff;verticalAlign=middle;align=center;arcSize=12;fillColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="220" height="66" as="geometry"/></mxCell><mxCell id="e1" value="worker claims&#10;SELECT ... FOR UPDATE SKIP LOCKED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1F2430;fontColor=#1F2430;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="PEND" target="INPR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="stage succeeded&#10;next stage job INSERTed in the same txn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="INPR" target="DONE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="transient failure&#10;next_attempt_at = now() + backoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="INPR" target="RETW"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="poller: next_attempt_at &lt;= now()&#10;same job, same stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="RETW" target="PEND"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="attempts &gt;= max_attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="RETW" target="DEAD"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="permanent error &#8212; no retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="INPR" target="DEAD"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="written with stage, error, payload_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="DEAD" target="DLR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="lease expired&#10;locked_at &lt; now() - 10 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="INPR" target="REAP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="status=PENDING, locked_by=NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="REAP" target="PEND"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="ops picks it up from the dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1E2761;fontColor=#1E2761;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="DEAD" target="REPL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="status=PENDING, attempts=0&#10;next_attempt_at=now()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1E2761;fontColor=#1E2761;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;jumpStyle=arc;" edge="1" parent="1" source="REPL" target="PEND"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Why one row is enough&lt;/b&gt;&lt;br/&gt;&#8226; Retry = two column writes (attempts, next_attempt_at). No timer thread, so a restart loses nothing.&lt;br/&gt;&#8226; Orphan recovery = lease expiry. A dead VM cannot strand work.&lt;br/&gt;&#8226; Replay = the same reset the reaper does, triggered by a human instead of a timeout.&lt;br/&gt;&#8226; All three converge on PENDING, so there is exactly one execution path to test and monitor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#D4DCEC;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="720" width="990" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page12" name="12. Retry - restart at the same stage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Retry — How a Failed Stage Restarts at That Same Stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="n12" value="The job row carries the stage identity, so a retry can only ever re-run the stage that failed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Stage Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="884" as="geometry"/></mxCell><mxCell id="n14" value="orchestration_job" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="170" height="884" as="geometry"/></mxCell><mxCell id="n15" value="orchestration_case" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="170" height="884" as="geometry"/></mxCell><mxCell id="n16" value="Central Data Lake" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="96" width="170" height="884" as="geometry"/></mxCell><mxCell id="n17" value="claim: WHERE job_type='PUBLISH_LAKE_V21' AND status='PENDING' AND next_attempt_at&lt;=now()" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="142" as="sourcePoint"/><mxPoint x="365.0" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="job {stage=PUBLISH_LAKE_V21, schema='address', attempts=0}" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="196" as="sourcePoint"/><mxPoint x="125.0" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="status=IN_PROGRESS, locked_by='vm1', locked_at=now()" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="250" as="sourcePoint"/><mxPoint x="365.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="POST /ingest/address" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="304" as="sourcePoint"/><mxPoint x="845.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="HTTP 503 (transient)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=2.2;strokeColor=#C0392B;fontColor=#C0392B;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="358" as="sourcePoint"/><mxPoint x="125.0" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="status=RETRY_WAIT, attempts=1, next_attempt_at=now()+1s, locked_by=NULL" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="412" as="sourcePoint"/><mxPoint x="365.0" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="The case row is NOT touched. It stays at PUBLISHING_V21 — the stage the pipeline is genuinely at." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="452" width="250" height="71" as="geometry"/></mxCell><mxCell id="n24" value="case status unchanged (still PUBLISHING_V21)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="520" as="sourcePoint"/><mxPoint x="605.0" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="poller wakes ~500ms; row not yet due, skipped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#B7791F;fontColor=#B7791F;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="574" as="sourcePoint"/><mxPoint x="125.0" y="604" as="targetPoint"/><Array as="points"><mxPoint x="243.0" y="574"/><mxPoint x="243.0" y="604"/></Array></mxGeometry></mxCell><mxCell id="n26" value="re-claim the SAME row once next_attempt_at has passed" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="626" as="sourcePoint"/><mxPoint x="365.0" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="POST /ingest/address   (attempt 2)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="680" as="sourcePoint"/><mxPoint x="845.0" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n28" value="202 {journalId}" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="734" as="sourcePoint"/><mxPoint x="125.0" y="734" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="status=DONE, finished_at=now()" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="788" as="sourcePoint"/><mxPoint x="365.0" y="788" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n30" value="Restart-at-stage is structural: the row names its own stage and schema, so nothing earlier can re-run." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="828" width="250" height="86" as="geometry"/></mxCell><mxCell id="n31" value="last schema confirmed -&gt; case = LAKE_CONFIRMED, enqueue HYDRATE" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="896" as="sourcePoint"/><mxPoint x="605.0" y="896" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page13" name="13. Retriever - orphaned job recovery"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Retriever — Recovering a Job Whose Worker Died Mid-stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="n12" value="Lease expiry is what makes a crash indistinguishable from a slow retry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Worker (VM 1)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="666" as="geometry"/></mxCell><mxCell id="n14" value="orchestration_job" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="170" height="666" as="geometry"/></mxCell><mxCell id="n15" value="Reaper (scheduler)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="170" height="666" as="geometry"/></mxCell><mxCell id="n16" value="Worker (VM 2)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="96" width="170" height="666" as="geometry"/></mxCell><mxCell id="n17" value="claim job, status=IN_PROGRESS, locked_by='vm1', locked_at=10:00:00" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="142" as="sourcePoint"/><mxPoint x="365.0" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="VM 1 is killed mid-stage (crash / deploy / power)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#C0392B;fontColor=#C0392B;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="196" as="sourcePoint"/><mxPoint x="125.0" y="226" as="targetPoint"/><Array as="points"><mxPoint x="243.0" y="196"/><mxPoint x="243.0" y="226"/></Array></mxGeometry></mxCell><mxCell id="n19" value="The row is now stranded: IN_PROGRESS, but nobody is executing it. No poller will pick it up." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="234" width="250" height="71" as="geometry"/></mxCell><mxCell id="n20" value="every 60s: WHERE status='IN_PROGRESS' AND locked_at &lt; now()-10min" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605.0" y="302" as="sourcePoint"/><mxPoint x="365.0" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="1 expired row (lease elapsed)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="356" as="sourcePoint"/><mxPoint x="605.0" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="status=PENDING, locked_by=NULL, attempts unchanged" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605.0" y="410" as="sourcePoint"/><mxPoint x="365.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="attempts is deliberately NOT incremented: a crash is not a failed attempt against the target system." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="450" width="250" height="71" as="geometry"/></mxCell><mxCell id="n24" value="normal poll claims the row" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="518" as="sourcePoint"/><mxPoint x="365.0" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="status=IN_PROGRESS, locked_by='vm2'" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="572" as="sourcePoint"/><mxPoint x="365.0" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="re-runs the stage from its persisted input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="626" as="sourcePoint"/><mxPoint x="845.0" y="656" as="targetPoint"/><Array as="points"><mxPoint x="963.0" y="626"/><mxPoint x="963.0" y="656"/></Array></mxGeometry></mxCell><mxCell id="n27" value="Safe because every stage is idempotent: a repeated lake ingest simply yields a fresh journalId that supersedes." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="664" width="250" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page14" name="14. Replay from a chosen stage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Replay — Restarting a Dead Case From a Chosen Stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="n12" value="Replay reuses the persisted stage input, so stages before the replay point are never re-executed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Ops / Dashboard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="936" as="geometry"/></mxCell><mxCell id="n14" value="Orchestration Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="170" height="936" as="geometry"/></mxCell><mxCell id="n15" value="Postgres (case / job / payload)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="170" height="936" as="geometry"/></mxCell><mxCell id="n16" value="Central Data Lake" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="96" width="170" height="936" as="geometry"/></mxCell><mxCell id="n17" value="POST /orchestrations/{id}/replay?fromStage=CONVERT  + reason" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="142" as="sourcePoint"/><mxPoint x="365.0" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="validate: case is FAILED_* and CONVERT input exists" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="196" as="sourcePoint"/><mxPoint x="605.0" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="case_payload(HYDRATED_V21) present" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605.0" y="250" as="sourcePoint"/><mxPoint x="365.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="A replay point is only offered if its input payload was persisted. You cannot replay from a stage with no input." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="290" width="250" height="86" as="geometry"/></mxCell><mxCell id="n21" value="case.status = HYDRATED (rewind to just before CONVERT)" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="358" as="sourcePoint"/><mxPoint x="605.0" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="INSERT job {stage=CONVERT, attempts=0, next_attempt_at=now()}" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="412" as="sourcePoint"/><mxPoint x="605.0" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="dead_letter.status = REPLAYED, audit {actor, reason}" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="466" as="sourcePoint"/><mxPoint x="605.0" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n24" value="202 replay accepted" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="520" as="sourcePoint"/><mxPoint x="125.0" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="worker claims the new CONVERT job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="574" as="sourcePoint"/><mxPoint x="365.0" y="604" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="574"/><mxPoint x="483.0" y="604"/></Array></mxGeometry></mxCell><mxCell id="n26" value="read case_payload(HYDRATED_V21) — the stored 9 schemas" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="626" as="sourcePoint"/><mxPoint x="605.0" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="The lake is NOT re-read. Replay is reproducible: it converts exactly the data the failed run saw." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="666" width="250" height="71" as="geometry"/></mxCell><mxCell id="n28" value="convert 9 -&gt; 13 with the fixed rule version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="734" as="sourcePoint"/><mxPoint x="365.0" y="764" as="targetPoint"/><Array as="points"><mxPoint x="483.0" y="734"/><mxPoint x="483.0" y="764"/></Array></mxGeometry></mxCell><mxCell id="n29" value="ingest 13 v1 schemas" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#1F2430;fontColor=#1F2430;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="786" as="sourcePoint"/><mxPoint x="845.0" y="786" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n30" value="13 fresh journalIds" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="840" as="sourcePoint"/><mxPoint x="365.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n31" value="If v1 had partially published before the failure, the new journalIds supersede the old ones in lake_journal." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D9C89A;fontColor=#1F2430;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="880" width="250" height="86" as="geometry"/></mxCell><mxCell id="n32" value="status=COMPLETED, release client's next event" style="html=1;verticalAlign=bottom;align=center;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;strokeWidth=1.6;strokeColor=#028090;fontColor=#028090;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="948" as="sourcePoint"/><mxPoint x="605.0" y="948" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>