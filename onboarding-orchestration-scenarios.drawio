#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="496" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg12_22" value="attempts is deliberately not incremented - a crashed VM is not a failed attempt against the target system." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9C89A;fontSize=12;fontColor=#1F2430;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="64" y="554" width="1058" height="46" as="geometry"/></mxCell><mxCell id="pg12_23" value="normal poll claims the row" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1F2430;fontColor=#1F2430;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1007.0" y="632" as="sourcePoint"/><mxPoint x="455.0" y="632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg12_24" value="6" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="622" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg12_25" value="status=IN_PROGRESS, locked_by='vm2'" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1F2430;fontColor=#1F2430;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1007.0" y="690" as="sourcePoint"/><mxPoint x="455.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg12_26" value="7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="680" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg12_27" value="re-runs the stage from its persisted input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fo