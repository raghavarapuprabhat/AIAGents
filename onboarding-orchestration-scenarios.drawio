=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="902" y="96" width="210" height="54" as="geometry"/></mxCell><mxCell id="pg12_11" value="claim job, status=IN_PROGRESS, locked_by='vm1', locked_at=10:00:00" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1F2430;fontColor=#1F2430;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="200" as="sourcePoint"/><mxPoint x="455.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg12_12" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="190" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg12_13" value="VM 1 killed mid-stage (crash / deploy / power)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="258" as="sourcePoint"/><mxPoint x="187.0" y="292" as="targetPoint"/><Array as="points"><mxPoint x="309.0" y="258"/><mxPoint x="309.0" y="292"/></Array></mxGeometry></mxCell><mxCell id="pg12_14" value="2" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="248" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg12_15" value="The row is now stranded: IN_PROGRESS but nobody is executing it. Pollers only look at PENDING, so it would sit forever." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9C89A;fontSize=12;fontColor=#1F2430;align=left;ver