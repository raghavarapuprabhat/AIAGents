or=#ffffff;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="230" height="68" as="geometry"/></mxCell><mxCell id="st_19" value="&lt;b&gt;dead_letter row&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;case = FAILED_&lt;stage&gt;, alert&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="230" height="68" as="geometry"/></mxCell><mxCell id="st_20" value="&lt;b&gt;Reaper (60s)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;finds expired leases&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="230" height="68" as="geometry"/></mxCell><mxCell id="st_21" value="&lt;b&gt;Ops replay&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;audited, reason required&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="230" height="68" as="geometry"/></mxCell><mxCell id="st_22" value="Retry, orphan recovery and replay all converge on PENDING - one execution path to test and monitor. Retry = two column writes, so a restart never loses a pending attempt. Orphan recovery = lease expiry, so a dead VM cannot strand work (attempts is NOT incremented - a crash is not a failed attempt). Replay = the same reset, triggered by a human instead of a timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FB;strokeColor=#D4DCEC;fontSize=12;fontColor=#1F2430;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="742" width="1020" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg11" name="12. Retry at same stage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1136" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg11_1" value="Retry - How a Failed Stage Restarts at That Same Stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="74" y="24" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pg11_2" value="The job row carries the stage identity, so a retry can only re-run the stage that failed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="74" y="54" width="1300" height="20" as="geometry"/></mxCell><mxCell id="pg11_3" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 6;strokeWidth=1.4;strokeColor=#9AA4B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="150" as="sourcePoint"/><mxPoint x="179.0" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_4" value="Stage Worker" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="74" y="96" width="210" height="54" as="geometry"/></mxCell><mxCell id="pg11_5" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 6;strokeWidth=1.4;strokeColor=#9AA4B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="150" as="sourcePoint"/><mxPoint x="455.0" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_6" value="orchestration_job" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="96" width="210" height="54" as="geometry"/></mxCell><mxCell id="pg11_7" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 6;strokeWidth=1.4;strokeColor=#9AA4B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="731.0" y="150" as="sourcePoint"/><mxPoint x="731.0" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_8" value="orchestration_case" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="626" y="96" width="210" height="54" as="geometry"/></mxCell><mxCell id="pg11_9" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 6;strokeWidth=1.4;strokeColor=#9AA4B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1007.0" y="150" as="sourcePoint"/><mxPoint x="1007.0" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_10" value="Central Data Lake" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="902" y="96" width="210" height="54" as="geometry"/></mxCell><mxCell id="pg11_11" value="claim WHERE job_type='PUBLISH_LAKE_V21' AND status='PENDING' AND next_attempt_at&lt;=now()" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#1F2430;fontColor=#1F2430;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="200" as="sourcePoint"/><mxPoint x="455.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_12" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="190" width="24" h