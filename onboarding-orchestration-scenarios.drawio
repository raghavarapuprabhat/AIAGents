metry"/></mxCell><mxCell id="pg11_19" value="HTTP 503 (transient)" style="html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;fontStyle=1;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1007.0" y="432" as="sourcePoint"/><mxPoint x="179.0" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_20" value="5" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="422" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_21" value="status=RETRY_WAIT, attempts=1, next_attempt_at=now()+1s, locked_by=NULL" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="490" as="sourcePoint"/><mxPoint x="455.0" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_22" value="6" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="480" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_23" value="case status unchanged - still PUBLISHING_V21" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="548" as="sourcePoint"/><mxPoint x="731.0" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_24" value="7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="538" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_25" value="Retry is a JOB-level concept. The case row only moves when a stage completes, so it always shows where the pipeline truly is." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9C89A;fontSize=12;fontColor=#1F2430;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="64" y="596" width="1058" height="46" as="geometry"/></mxCell><mxCell id="pg11_26" value="poller wakes ~500ms; row not yet due, skipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="674" as="sourcePoint"/><mxPoint x="187.0" y="708" as="targetPoint"/><Array as="points"><mxPoint x="309.0" y="674"/><mxPoint x="309.0" y="708"/></Array></mxGeometry></mxCell><mxCell id="pg11_27" value="8" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="664" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_28" value="re-claim the SAME row once next_attempt_at has passed" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="738" as="sourcePoint"/><mxPoint x="455.0" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_29" value="9" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="728" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_30" value="POST /ingest/address (attempt 2)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#B7791F;fontColor=#B7791F;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="796" as="sourcePoint"/><mxPoint x="1007.0" y="796" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_31" value="10" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="786" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_32" value="202 {journalId}" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1007.0" y="854" as="sourcePoint"/><mxPoint x="179.0" y="854" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_33" value="11" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="844" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_34" value="status=DONE, finished_at=now()" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="912" as="sourcePoint"/><mxPoint x="455.0" y="912" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_35" value="12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="902" width="24" height="20" as="geometry"/></mxCell><mxCell id="pg11_36" value="Restart-at-stage is structural: the row names its own stage and schema, so nothing earlier can possibly re-run." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9C89A;fontSize=12;fontColor=#1F2430;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="64" y="960" width="1058" height="46" as="geometry"/></mxCell><mxCell id="pg11_37" value="last schema confirmed - LAKE_CONFIRMED, enqueue HYDRATE" style="html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#028090;fontColor=#028090;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="179.0" y="1038" as="sourcePoint"/><mxPoint x="731.0" y="1038" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg11_38" value="13" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="12" y="1028" width="24" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg12" name="13. Retriever / reaper"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1466" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg12_1" value="Retriever - Recovering a Job Whose Worker Died Mid-stage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1"><mxGeometry x="74" y="24" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pg12_2" value="Lease expiry is what makes a crash recoverable without human involvement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="74" y="54" width="1300" height="20" as="geometry"/></mxCell><mxCell id="pg12_3" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 6;strokeWidth=1.4;strokeColor=#9AA4B8;" edge="1" parent="1"><mxG